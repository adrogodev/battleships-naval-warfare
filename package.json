{
  "name": "battleships",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @battleships/client dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck && tsc -p e2e/tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "simulate": "tsx scripts/simulate-ai.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
